# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection - using MongoDB Atlas or your local MongoDB instance
# If using MongoDB Atlas, the URI would look like: mongodb+srv://username:password@cluster.mongodb.net/apptlinker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/apptlinker-hub

# JWT Secret - using a strong, randomly generated secret
JWT_SECRET=h8%p@9j2$K!7QnT^4Dc3bFv#6zL*sY1x

# Token expiration (in seconds) - 24 hours
JWT_EXPIRE=86400

# Encryption key for sensitive data (32 characters for AES-256)
ENCRYPTION_KEY=A8q#r2P*z7TnF@v5XjH$dK9!mEcG6L3y
